# Copy this file to .env and fill in real values. Never commit .env itself.

# From your Neon project -> Connection Details -> pick your "dev" branch.
# Must be the psycopg (v3) style URL: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require&channel_binding=require

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Comma-separated list of origins allowed to call this API (your Next.js dev
# server locally, your real Vercel URL later). Port 3001, not 3000 -- this
# app's local dev convention runs its frontend on 3001 so it can run
# alongside the sibling WMS Readiness Tracker's frontend (port 3000)
# without a conflict.
CORS_ORIGINS=http://localhost:3001

# "lax" for local dev. "none" once frontend and backend are on two different
# real domains (e.g. Vercel + Render).
COOKIE_SAMESITE=lax

# Optional. Powers AI-generated recommendation explanations in a later phase
# (not used by Phase 0). Get a free key (no card required) at
# https://console.groq.com/keys.
GROQ_API_KEY=
